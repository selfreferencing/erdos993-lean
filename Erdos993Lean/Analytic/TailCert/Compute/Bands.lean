/-- The check of band `i` at the Laplace parameter `t_j`. -/
def checkIJ (i j : Nat) : Bool :=
  checkBand (edgesC.getD i 0) (edgesC.getD (i + 1) 0) ((aTabC.getD i []).getD j 0)
    ((ratesC.getD i []).getD j 0) (tvalsC.getD j 0)

/-- The five checks of band `i`. -/
@[noinline] def checkRow (i : Nat) : Bool :=
  checkIJ i 0 && checkIJ i 1 && checkIJ i 2 && checkIJ i 3 && checkIJ i 4

